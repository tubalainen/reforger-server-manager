  "cards": [
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "Each stack's gate shows its manager only that stack's containers and volumes.",
        "The edge reaches each manager over that stack's own network, nothing else."
      ]
    },
    {
      "dot": "cyan",
      "title": "Who uses what",
      "items": [
        "Team admins only ever use their own manager's web GUI.",
        "The host admin runs rsm and reads every stack on the Supervisor, which never sees a team's password."
      ]
    }
