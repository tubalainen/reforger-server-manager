  "cards": [
    {
      "dot": "cyan",
      "title": "Core design",
      "items": [
        "The manager combines the Vue interface and FastAPI control API.",
        "Docker runs the download jobs and one container per game server."
      ]
    },
    {
      "dot": "rose",
      "title": "Security boundary",
      "items": [
        "Only the Docker gate holds the socket, and it has no network.",
        "Each stack sees only its own containers and mounts only its own volumes."
      ]
    }
