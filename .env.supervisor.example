# ============================================================
# Reforger Server Supervisor — configuration
# Copy to .env next to docker-compose.supervisor.yaml and adjust.
# ============================================================
# The Supervisor shows every stack on this machine, read-only, for whoever
# manages the machine (#204). It is its own install: this is not a team's .env,
# and it holds none of their settings.

# --- Web page ----------------------------------------------------------------
# 127.0.0.1 keeps the page on this machine (reach it through an SSH tunnel:
#   ssh -L 7090:localhost:7090 you@this-machine
# then open http://localhost:7090). 0.0.0.0 puts it on your network; it then
# refuses to start with the example password below.
WEB_BIND=127.0.0.1
WEB_PORT=7090

# --- Login (REQUIRED) -----------------------------------------------------------
# Its own username and password, not any team's. Write a literal dollar sign
# twice ($$): Docker Compose eats a single one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
# Empty: a random one at every start, which signs everyone out on a restart.
SESSION_SECRET=

# Session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# Behind a reverse proxy: which proxies' X-Forwarded-For to believe (see the
# manager's .env.example for the details). Leave empty when reached directly.
TRUSTED_PROXIES=

# Only send the session cookie over HTTPS (turn on behind a TLS proxy).
SESSION_COOKIE_SECURE=false

# --- Version -------------------------------------------------------------------
# The Supervisor runs the manager's image. 'latest' follows every release; a
# tag such as v0.67.0 locks it. Keep it no older than your newest stack.
MANAGER_VERSION=latest

# --- Misc ----------------------------------------------------------------------
TZ=Europe/Stockholm
