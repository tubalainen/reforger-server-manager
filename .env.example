# ============================================================
# Reforger Server Manager — configuration
# Copy to .env and adjust. Every setting the stack needs lives here.
# ============================================================

# --- Web GUI ---------------------------------------------------------------
# Address the GUI binds to on the HOST. Use 127.0.0.1 behind a reverse proxy,
# or 0.0.0.0 to expose directly (built-in login still applies — use a strong
# password and preferably a firewall).
#
# SAFETY GATE: when WEB_BIND is anything other than a loopback address the app
# refuses to start with an insecure auth setup — i.e. the example password (see
# ADMIN_PASSWORD) or AUTH_ENABLED=false without AUTH_DELEGATED_ACK=true. A
# loopback bind (127.0.0.1) keeps a local quick-start frictionless.
WEB_BIND=127.0.0.1
WEB_PORT=7780

# --- VPS deployment only (docker-compose.vps.yaml) ---------------------------
# Ignored by the normal docker-compose.yaml. Where Caddy should serve the GUI:
#
#   reforger.example.com   a domain you point at this VPS. Caddy obtains and
#                          renews a real Let's Encrypt certificate on its own —
#                          this is the recommended, fully-encrypted setup.
#   :80                    plain HTTP on the bare IP, no certificate. TESTING
#                          ONLY: the login and the session travel unencrypted.
#
# Point the DNS A record at this server BEFORE the first start, so the initial
# certificate request succeeds.
SITE_ADDRESS=reforger.example.com

# --- Authentication (REQUIRED) ----------------------------------------------
# The username and password for the web GUI login. Change both.
#
# IMPORTANT — a literal dollar sign ($) must be written TWICE ($$). Docker
# Compose treats a single $ in this file as a variable reference and eats it,
# so ADMIN_PASSWORD=abc$def would reach the app as "abc" and the login would
# never work, while ADMIN_USERNAME=$name would arrive EMPTY and the GUI would
# report "not configured". Double every $ you actually want:
#   ADMIN_PASSWORD=abc$$def   -> the app sees  abc$def
# No other characters need escaping.
#
# Change ADMIN_PASSWORD before exposing the GUI: if WEB_BIND is not a loopback
# address the app REFUSES TO START while this is still the example value below
# (or empty). Pick a long, unique password — these are effectively host-root
# credentials (the GUI controls Docker).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Built-in login. Leave as 'true' unless a reverse proxy in front of the app
# (NGINX, Caddy, Authelia, …) enforces authentication for you. Setting this to
# 'false' DISABLES the username/password prompt entirely — the GUI, which
# controls Docker, becomes fully open to anyone who can reach it. Only do this
# behind a proxy that authenticates every request.
AUTH_ENABLED=true

# Opt out of the built-in login and let a reverse proxy handle authentication:
# set AUTH_ENABLED=false AND AUTH_DELEGATED_ACK=true. The ack is required only
# when the GUI is exposed (non-loopback WEB_BIND) and is your explicit promise
# that a proxy in front authenticates every request. Without it, an exposed
# AUTH_ENABLED=false start is refused (the GUI controls Docker — see WEB_BIND).
AUTH_DELEGATED_ACK=false

# Reverse proxies whose X-Forwarded-For header may be believed, as a comma-
# separated list of IPs and/or CIDR ranges. Login attempts are rate-limited per
# client address; behind a proxy EVERY request arrives from the proxy, so
# without this the limit becomes one shared bucket — real attackers are not
# slowed individually, and one of them can lock everybody else out.
#
# Leave EMPTY when the GUI is reached directly (the safe default): the header is
# then ignored completely, so nobody can forge an identity or frame another
# address. Only list proxies you actually run. docker-compose.vps.yaml sets this
# for its bundled Caddy automatically.
#   e.g. TRUSTED_PROXIES=172.31.242.0/24,10.0.0.5
TRUSTED_PROXIES=

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
# If left empty a random secret is generated at startup (all sessions are
# invalidated whenever the container restarts).
SESSION_SECRET=

# Session lifetime in hours (default 7 days)
SESSION_TTL_HOURS=168

# --- Docker integration ------------------------------------------------------
# Which build of the manager itself to run, as an image tag.
#   latest   -> follow every release. The Windows start.ps1 pulls it on start,
#               so a double-click keeps you up to date. On Linux run
#               `docker compose pull` before `up -d` to update.
#   vX.Y.Z   -> LOCK the manager to that exact release so it never changes,
#               e.g. MANAGER_VERSION=v0.31.0
# Releases: https://github.com/tubalainen/reforger-server-manager/releases
MANAGER_VERSION=latest

# Image used for spawned Arma Reforger Dedicated Server instances.
# The default (ACE Mod's image) consumes a mounted config.json via ARMA_CONFIG.
REFORGER_SERVER_IMAGE=ghcr.io/acemod/arma-reforger:latest

# Image used for the one-shot "Download server files" jobs.
STEAMCMD_IMAGE=steamcmd/steamcmd:latest

# Both images above follow ':latest' on purpose: the Arma server image needs to
# track game updates, and pinning it would silently leave you on an old build
# after a Reforger release. The trade-off is that you run whatever upstream
# publishes, so a compromised or broken upstream tag reaches you with no change
# on your side.
#
# To pin instead — reproducible, but you must bump it yourself for every game
# update — put a digest here, which unlike a tag cannot be moved:
#   REFORGER_SERVER_IMAGE=ghcr.io/acemod/arma-reforger@sha256:<digest>
# Read the current digest with:
#   docker image inspect --format '{{index .RepoDigests 0}}' <image>

# Least-privilege Docker socket proxy the manager talks to instead of mounting
# the root-equivalent /var/run/docker.sock directly (see the security note in
# the README). Pin to a digest for the strongest supply-chain guarantee.
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.1

# Abort a server-file download if it runs longer than this many minutes.
STEAMCMD_TIMEOUT_MINUTES=60

# Delete per-session server log/crash folders older than this many days.
LOG_RETENTION_DAYS=14

# --- Server networking --------------------------------------------------------
# Public IP address of this machine, advertised to the Arma backend.
# Leave empty to auto-detect.
PUBLIC_ADDRESS=

# Host UDP port ranges the manager may lease to server instances
# (one port of each kind per instance).
GAME_PORT_RANGE=2001-2020
A2S_PORT_RANGE=17777-17796
RCON_PORT_RANGE=19999-20018

# --- Misc ---------------------------------------------------------------------
TZ=Europe/Stockholm

# --- One-click AI mod ordering (optional) ---------------------------------------
# The Mods step of a template has an "AI order…" button that asks an AI for a mod
# load order. It works with NOTHING set here: it hands you the prompt to paste
# into ChatGPT, Gemini or Claude, which are free and need no key. Leaving these
# empty means the manager itself never contacts an AI service.
#
# Fill them in to turn that button into one click. Any OpenAI-compatible chat
# completions endpoint works — the manager POSTs {model, messages} and reads
# choices[0].message.content. Some that are free at the time of writing:
#
#   Google Gemini (free API key from aistudio.google.com):
#     AI_ORDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#     AI_ORDER_MODEL=gemini-2.5-flash
#   OpenRouter, using one of its ':free' models:
#     AI_ORDER_URL=https://openrouter.ai/api/v1/chat/completions
#     AI_ORDER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   A local Ollama on the same host (no key, no data leaves the machine):
#     AI_ORDER_URL=http://host.docker.internal:11434/v1/chat/completions
#     AI_ORDER_MODEL=llama3.1
#
# The key is sent to that endpoint as a bearer token and to nowhere else. The
# request contains mod ids, mod names and which mod requires which — no server
# name, no passwords, no player data. Remember to double any literal '$'.
AI_ORDER_URL=
AI_ORDER_MODEL=
AI_ORDER_KEY=

# --- Advanced (rarely changed; defaults are right for the compose setup) -------
# Where the manager keeps its database, per-instance configs, profiles and logs.
# Must match the container path mounted in docker-compose.yaml.
DATA_DIR=/data

# Where the downloaded server files live, one folder per branch.
SERVERFILES_DIR=/serverfiles

# The Docker network the manager attaches spawned server containers to. Must match
# the network named in docker-compose.yaml.
DOCKER_NETWORK=reforger-net

# Directory the built web GUI is served from. Set in the image; leave empty to run
# the API without a frontend (development).
# STATIC_DIR=/app/static

# Mark the session cookie "secure" so the browser only ever sends it over HTTPS.
# Turn this on when a TLS reverse proxy fronts the GUI. Leave false for the plain
# HTTP localhost default, where a secure cookie would never be sent at all.
SESSION_COOKIE_SECURE=false

# Serve the interactive API docs (/docs, /redoc, /openapi.json). Off by default:
# they list every endpoint of an API that controls Docker, to anyone who asks,
# before any login is required. Turn on only for local development.
API_DOCS=false

# Extra browser origins allowed to make state-changing requests (comma separated,
# e.g. https://reforger.example.com). Same-origin requests always work and need
# nothing here — only set this if a reverse proxy rewrites the Host header.
ALLOWED_ORIGINS=

# Override the Content-Security-Policy sent with every response. Leave empty for
# the built-in policy, which allows no third-party scripts and no inline script
# at all. Only set this if you deliberately need a looser policy.
CONTENT_SECURITY_POLICY=

# Run the GAME SERVER containers with 'no-new-privileges'. Off by default: in
# v0.45.0 it was on, and players could not connect (issue #150). The flag is
# inherited by every child process and cannot be switched off again, and
# Reforger's BattlEye runs as a child of the server — so the server started
# normally and then refused players.
#
# The manager's own short-lived helper containers (SteamCMD downloads, cleanup)
# always use it; they have no anti-cheat and are unaffected. Set this to true
# only if you have tested that your server image and players tolerate it.
INSTANCE_NO_NEW_PRIVILEGES=false

# How game server containers attach to the network.
#
#   auto   (default) host networking everywhere except Docker Desktop
#   host   the server binds its UDP ports straight on the host
#   bridge ports published through Docker's NAT (the old behaviour)
#
# Game and A2S traffic must NOT pass through a proxy. Bridge networking puts
# Docker's userland 'docker-proxy' in front of every published UDP port and
# rewrites the source address to the bridge gateway, so the Arma server sees
# every player arriving from 172.x.0.1 — joins fail and BattlEye misbehaves.
# Host networking removes NAT from the path entirely and is how game servers
# are normally run in Docker.
#
# Docker Desktop (Windows/macOS) has no true host networking, so 'auto' keeps
# bridge there; that is the one place published ports are still used.
INSTANCE_NETWORK_MODE=auto
